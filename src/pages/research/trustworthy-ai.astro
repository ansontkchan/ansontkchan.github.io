---
import Layout from "../../layouts/Layout.astro";
import trust from "../../assets/trust.png";
---

<Layout title="Trustworthy AI">
  <main class="page-container">
    
    <!-- HERO SECTION -->
    <section class="theme-hero-section">
      <div class="hero-content">
        <h1>Trustworthy AI</h1>
        <p>
          Designing advanced AI systems that are transparent and reliable.
        </p>
      </div>

      <div class="hero-image-container">
        <img
          src={trust.src}
          alt="Trustworthy AI"
          class="hero-icon"
        />
      </div>
    </section>

    <!-- STICKY SUB-NAV BAR -->
    <nav class="sub-nav-bar">
      <div class="sub-nav-links">
        <a href="#independent" class="sub-nav-item">
          Independent Research <span class="count">2</span>
        </a>
        <a href="#collaborative" class="sub-nav-item">
          Collaborative Research <span class="count">2</span>
        </a>
      </div>
    </nav>

    <!-- SECTION 1: Independent Research (Clean: No Tags) -->
    <div class="content-grid" id="independent">
      <aside class="sidebar">
        <h2>Independent Research</h2>
      </aside>

      <div class="project-list">
        <!-- Project 1 -->
        <div class="project-card">
        <span class="mono-date">Working</span>
          <h3>
            <a href="/research/neurosym">    
              Deductive Reasoning in AI Agents: A Neuro-symbolic Planner for Green Retrofitting
            </a>
          </h3>
          <p>
            A new neuro-symbolic approach to re-route the knowledge base in AI agents back to human expertise rather than relying on historical data in algorithms.
          </p>
        </div>

        <!-- Project 2 -->
        <div class="project-card">
        <span class="mono-date">Working</span>
          <h3>
            <a href="/research/great">
              GREAT (Green Retrofit Evidence-grounded Agent Team): Benchmarking Multi-agent RAG System
            </a>
          </h3>
          <p>
            Can a multi-agent RAG system develop and analyse green retrofitting plans better than single-agent and generic LLM systems? 
            We ran experiments to find out.
          </p>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Collaborative Research (Structured Bullets) -->
    <div class="content-grid" id="collaborative">
      <aside class="sidebar">
        <h2>Collaborative Research</h2>
      </aside>

      <div class="project-list">
        
    <!-- ESGPass Card -->
    <div class="project-card">
    <span class="mono-date">2025-Now</span>
      <h3>
    <a href="https://esgpass.com/#frameworks" target="_blank" rel="noopener noreferrer">
    ESGPass: AI for Corporate ESG Intelligence
    </a>
    </h3>
    
    <p>
    The first platform offering interpretable ESG report generation to automate compliance with precision, transparency, and trust by design.
    </p>
  
    <ul class="structured-bullets">
    <li>
      <strong>Role & Affiliation:</strong> Co-Founder, 
      <a href="https://llmplus.ai/" target="_blank" rel="noopener noreferrer" class="external-link"> LLM+</a>, 
      University of Cambridge.
    </li>
    <li>
      <strong>Project Scope:</strong> Automated compliance frameworks for corporate CSRD, ISSB, GRI, and TCFD report generation.
    </li>
    <li>
      <strong>Key Contributions:</strong> Conducted stakeholder interviews, consolidated global ESG reporting frameworks, and designed custom end-to-end LLM agent workflows.
    </li>
    </ul>
    
    </div>

    <!-- 2. OSDG -->
    <div class="project-card">
    <span class="mono-date">2020–2023</span>
      <h3>
    <a href="https://osdg.ai/" target="_blank" rel="noopener noreferrer">
    United Nations OSDG: Global Sustainability Intelligence
    </a>
    </h3>
    
    <p>
    How do science, technology and public policy contribute to Sustainable Development Goals?
    OSDG is a free and open-source tool that assigns SDG labels to your inputs.     
    </p>
          
    <ul class="structured-bullets">
    <li><strong>Role & Affiliation:</strong> Volunteer Data Scientist,
    <a href="https://sdgailab.org/" target="_blank" rel="noopener noreferrer" class="external-link"> SDG AI Lab</a>, 
    led by Dr Nuria Bautista Puig.</li>
   
    <li><strong>Project Scope:</strong> Mapped public and academic research documents directly   to the UN 2030 SDGs.</li>
    <li><strong>Key Contributions:</strong> Co-developed OSDG with over 2,500 online volunteers for 17 SDG corpus in over 1,000+ international research papers.</li>
    </ul>
    
    </div>

    </div>

</div>
</main>
</Layout>

<style>
  /* =========================================
     1. PAGE LAYOUT & GEOMETRY
     ========================================= */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  /* =========================================
     2. HERO SECTION (Side-by-Side)
     ========================================= */
  .theme-hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    padding: 4rem 0 1.5rem;
  }

  .hero-content {
    flex: 1;
    max-width: 650px;
  }

  .hero-content h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #111;
  }

  .hero-content p {
    font-size: 1.2rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }

  .hero-image-container {
    flex-shrink: 0;
    width: 240px;
  }

  .hero-icon {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* =========================================
     3. STICKY SUB-NAVIGATION BAR
     ========================================= */
  .sub-nav-bar {
    position: sticky;
    top: 0;
    background: rgba(250, 248, 245, 0.95); /* Slight transparency */
    backdrop-filter: blur(10px);           /* Blurs content behind it */
    z-index: 100;
    border-bottom: 1px solid #e5e5e5;
    padding: 1rem 0;
    margin-bottom: 3.5rem;
  }

  .sub-nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .sub-nav-item {
    font-size: 1rem;
    font-weight: 600;
    color: #666;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s;
  }

  .sub-nav-item:hover {
    color: #0067c0;
  }

  .sub-nav-item .count {
    font-size: 0.75rem;
    background: #e5e5e5;
    color: #555;
    padding: 0.1rem 0.4rem;
    border-radius: 10px;
    font-weight: 500;
  }

  /* =========================================
     4. CONTENT GRIDS (Sidebar + List)
     ========================================= */
  .content-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 4rem;
    padding-bottom: 2rem;       
    margin-bottom: 2rem;        
    border-bottom: 1px solid #e5e5e5; 
    scroll-margin-top: 6rem; /* Ensures sticky nav doesn't cover title when clicked */
  }

  .content-grid:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .sidebar h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #222;
    position: sticky;
    top: 5rem;
    margin: -0.2rem 0 0 0;
  }

  /* =========================================
     5. PROJECT CARDS & TYPOGRAPHY
     ========================================= */
  .project-card {
    padding: 2.5rem 0;
    border-top: 1px solid #e5e5e5;
  }
  
  .project-card:first-child {
    border-top: none;
    padding-top: 0;
  }

  .project-card h3 {
    margin: 0 0 0.75rem;
  }

  .project-card h3 a {
    color: #0067c0;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .project-card h3 a:hover {
    text-decoration: underline;
  }

  .project-card p {
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  /* =========================================
     6. COLLAB LISTS & LINKS (New Updates)
     ========================================= */
  .structured-bullets {
    margin: 1.25rem 0 0 0;
    padding-left: 1.2rem;
    list-style-type: square;
  }

  .structured-bullets li {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .structured-bullets strong {
    color: #222;
    font-weight: 600;
  }

  /* The Specific "Academic Blue" Link Style for LLM+ */
  .external-link {
    color: #0067c0;  /* Matches Main Title Blue exactly */
    font-weight: 700;
    text-decoration: none;
  }

  .external-link:hover {
    text-decoration: underline;
    color: #004b99;
  }

  /* =========================================
     7. MOBILE RESPONSIVE
     ========================================= */
  @media (max-width: 900px) {
    .theme-hero-section {
      flex-direction: column-reverse; /* Stacks image on top */
      align-items: flex-start;
      gap: 2rem;
      padding: 3rem 0 1rem;
    }

    .content-grid {
      grid-template-columns: 1fr; /* Stacks sidebar above list */
      gap: 1rem;
    }

    .sidebar h2 {
      position: static;
      border-bottom: 2px solid #eee;
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
    }
  }

  .mono-date {
  font-family: monospace; /* Technical feel */
  font-size: 0.85rem;
  color: #888;            /* Subtle Grey */
  font-weight: 500;
  display: block;
  margin-bottom: 0.5rem;  /* Space between date and title */
  letter-spacing: 0.05em;
}

/* Ensure the title spacing is tight */
.project-card h3 {
  margin-top: 0;
  line-height: 1.35;
}
</style>

