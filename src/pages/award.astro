---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Scholarships & Awards | Anson Chan">
  
  <!-- 🛠️ FIX: Added the 1100px Container Wrapper -->
  <main class="page-container">
    
    <!-- 1. HERO SECTION -->
    <section class="intro-block">
      <h1>Scholarships & Awards</h1>
      <p class="intro-text">
        Recognitions for research contributions, policy impact, and technical innovation in the built environment and AI governance.
      </p>
    </section>

    <!-- 2. AWARDS LIST (News Card Layout) -->
    <section class="awards-list">

      <!-- Item 1: Conference Award -->
      <article class="news-card">
        <div class="news-thumb">
          <!-- 📸 REPLACE: Place your image in public/awards/ folder -->
          <img src="/awards/iaqvec-award.jpg" alt="Best Paper Award Ceremony" />
        </div>
        <div class="news-content">
          <span class="news-date">June 2025</span>
          <h3>
            <a href="https://www.leru.org/doctoral-summer-school">
              Cambridge Ford Britain Trust:  League of European Research Universities Doctoral Summer School (LERU, 2025)
            </a>
          </h3>
          <p>
            Awarded for representing the University of Cambridge: Artificial Intelligence across University Disciplines – Perspectives and Hands-on Experience..
          </p>
          <a href="https://www.linkedin.com/posts/anson-chan-b836331b9_ai-doctoral-phd-ugcPost-7345574696471445504-Jvi7/?utm_source=share&utm_medium=member_desktop&rcm=ACoAADLRJdMBPXJtMRMbGGzOcZxwgVTWI7wMIYI">Read more →</a>
        </div>
      </article>

      <!-- Item 2: BacBudy -->
      <article class="news-card">
        <div class="news-thumb">
          <!-- 📸 REPLACE: Place your image in public/awards/ folder -->
          <img src="/awards/iaqvec-award.jpg" alt="Best Paper Award Ceremony" />
        </div>
        <div class="news-content">
          <span class="news-date">June 2025</span>
          <h3>
            <a href="#" class="news-title-link">
            Champion: Cambridge Buildhouse x NVIDIA Startup Pitch Competition
            </a>
          </h3>
          <p>
            Awarded for attending the LERU PhD Summer School at the University of Copenhagen: .
          </p>
          <a href="#" class="read-more-link">Read more →</a>
        </div>
      </article>

      <!-- Item 3: Dorsett -->
      <article class="news-card">
        <div class="news-thumb">
          <img src="/awards/keynote-speech.jpg" alt="Keynote Speech at HKUST" />
        </div>
        <div class="news-content">

          <span class="news-date">Jul 2024</span>
          <h3>
            <a href="#" class="news-title-link">
              Dorsett Scholarship
            </a>
          </h3>
          <p>
            Invited by the HKUST Policy Lab to speak on "The Geopolitics of AI Safety," discussing the divergence in safety standards between the EU AI Act and China's Generative AI Measures.
          </p>
          <a href="#" class="read-more-link">Watch Recording →</a>
        </div>
      </article>

      <!-- Item 3: Fellowship -->
      <article class="news-card">
        <div class="news-thumb">
          <img src="/awards/fellowship.jpg" alt="Cambridge Fellowship" />
        </div>
        <div class="news-content">
          <span class="news-date">2025</span>
          <h3>
            <a href="#" class="news-title-link">
              Cambridge Trust International Scholarship
            </a>
          </h3>
          <p>
            Selected for the prestigious full-ride scholarship supporting doctoral research in Engineering at the University of Cambridge.
          </p>
        </div>
      </article>

    </section>

  </main>
</Layout>

<style>
  /* =========================================
     1. STANDARD 1100px LAYOUT (Fixes the "Width" Issue)
     ========================================= */
  .page-container {
    max-width: 1100px; /* 🎯 MATCHES YOUR OTHER PAGES EXACTLY */
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  /* =========================================
     2. HERO TYPOGRAPHY
     ========================================= */
  .intro-block {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 4rem;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #111;
    letter-spacing: -0.02em;
  }

  .intro-text {
    font-size: 1.25rem;
    line-height: 1.7;
    color: #444;
    max-width: 800px;
  }

  /* =========================================
     3. NEWS CARD LIST (Image Left / Text Right)
     ========================================= */
  .awards-list {
    display: flex;
    flex-direction: column;
    gap: 3rem; /* Spacing between items */
  }

  .news-card {
    display: flex;
    gap: 2.5rem; /* Space between Image and Text */
    align-items: flex-start;
    padding-bottom: 3rem;
    border-bottom: 1px solid #eee; /* Subtle divider line */
  }

  .news-card:last-child {
    border-bottom: none;
  }

  /* Image Box */
  .news-thumb {
    width: 280px;      /* Fixed width ensures perfect alignment */
    height: 180px;     /* Fixed height */
    flex-shrink: 0;    /* Prevents shrinking */
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #eee;
    background: #f9f9f9;
  }

  .news-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 📸 Crops photo nicely to fill the box */
    transition: transform 0.3s ease;
  }

  .news-card:hover .news-thumb img {
    transform: scale(1.05); /* Zoom effect on hover */
  }

  /* Content Box */
  .news-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 0.2rem;
  }

  .news-date {
    font-family: monospace;
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .news-content h3 {
    margin: 0 0 0.8rem 0;
    line-height: 1.3;
  }

  .news-title-link {
    font-size: 1.3rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
    transition: color 0.2s;
  }

  .news-title-link:hover {
    color: #0067c0; /* Academic Blue */
    text-decoration: underline;
  }

  .news-content p {
    font-size: 1rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .read-more-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0067c0;
    text-decoration: none;
  }

  .read-more-link:hover {
    text-decoration: underline;
    color: #004b99;
  }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .news-card {
      flex-direction: column; /* Stack image on top */
      gap: 1rem;
    }
    .news-thumb {
      width: 100%; /* Full width on phone */
      height: 220px;
    }
  }
</style>
