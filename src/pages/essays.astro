---
import Layout from "../layouts/Layout.astro";
// 📸 Ensure this image exists in src/assets/
import essays from "../assets/essays.png";
---

<Layout title="Essays | Anson Chan">
  <main class="page-container">
    
    <!-- 1. HERO SECTION (Identical to Homepage) -->
    <section class="hero">
      <div class="hero-text">
        <h1>Essays</h1>
        <p class="bio-text">
          Beyond technical research, I write about the <strong>governance of complex systems</strong>. 
          Reflections on decision intelligence, safety engineering, and the human side of AI policy.
        </p>      
      </div>

      <div class="hero-photo">
        <img src={essays.src} alt="Essays" class="hero-icon" />
      </div>
    </section>

    <!-- 2. ESSAYS LIST -->
    <section class="essay-list">
      
      <!-- Topic 1 -->
      <article class="essay-item">
        <div class="essay-meta">
          <span class="mono-date">Upcoming</span>
        </div>
        <div class="essay-content">
          <h3>
            <!-- href="#" keeps it clickable/blue but goes nowhere -->
            <a href="#" class="essay-link">What Construction Can Teach AI Safety</a>
          </h3>
          <p class="essay-desc">
            Civil engineering has spent a century mastering safety in high-stakes physical environments. Applying these "Safety Case" frameworks to AI governance.
          </p>
          <span class="coming-soon">Coming soon</span>
        </div>
      </article>

      <!-- Topic 2 -->
      <article class="essay-item">
        <div class="essay-meta">
          <span class="mono-date">Upcoming</span>
        </div>
        <div class="essay-content">
          <h3>
            <a href="#" class="essay-link">Green Retrofit Is Not an Optimisation Problem</a>
          </h3>
          <p class="essay-desc">
            Why treating policy challenges as math problems fails. Understanding the messiness of human incentives in net-zero transitions.
          </p>
          <span class="coming-soon">Coming soon</span>
        </div>
      </article>

      <!-- Topic 3 -->
      <article class="essay-item">
        <div class="essay-meta">
          <span class="mono-date">Upcoming</span>
        </div>
        <div class="essay-content">
          <h3>
            <a href="#" class="essay-link">Why Decision Intelligence Matters</a>
          </h3>
          <p class="essay-desc">
            Moving beyond "Prediction" (what will happen) to "Decision" (what we should do). The missing layer in the current GenAI stack.
          </p>
          <span class="coming-soon">Coming soon</span>
        </div>
      </article>

      <!-- Topic 4 -->
      <article class="essay-item">
        <div class="essay-meta">
          <span class="mono-date">Upcoming</span>
        </div>
        <div class="essay-content">
          <h3>
            <a href="#" class="essay-link">What Should Humans Decide, and What Should AI Decide?</a>
          </h3>
          <p class="essay-desc">
            A framework for "Human-in-the-loop" vs. "Human-on-the-loop." Defining the threshold of autonomous delegation in critical infrastructure.
          </p>
          <span class="coming-soon">Coming soon</span>
        </div>
      </article>

      <!-- Topic 5 -->
      <article class="essay-item">
        <div class="essay-meta">
          <span class="mono-date">Upcoming</span>
        </div>
        <div class="essay-content">
          <h3>
            <a href="#" class="essay-link">From Prediction to Decision</a>
          </h3>
          <p class="essay-desc">
            The economic value of AI lies not in generating text, but in reducing uncertainty in high-stakes decision-making.
          </p>
          <span class="coming-soon">Coming soon</span>
        </div>
      </article>

      <!-- Topic 6 -->
      <article class="essay-item">
        <div class="essay-meta">
          <span class="mono-date">Upcoming</span>
        </div>
        <div class="essay-content">
          <h3>
            <a href="#" class="essay-link">Building Trustworthy Human–AI Decision Systems</a>
          </h3>
          <p class="essay-desc">
            Trust is an engineering constraint, not a sentiment. How to architect systems that fail gracefully and explain their reasoning.
          </p>
          <span class="coming-soon">Coming soon</span>
        </div>
      </article>

    </section>

  </main>
</Layout>

<style>
  /* =========================================
     1. PAGE LAYOUT
     ========================================= */
  .page-container {
    max-width: 1100px; 
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  /* =========================================
     2. HERO SECTION (Identical to Homepage)
     ========================================= */
  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 5rem;
    padding: 5rem 0 5rem;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 0.5rem;
  }

  .hero-text {
    flex: 1;
    max-width: 680px;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #111;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bio-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #444;
    margin: 0;
  }
  
  .hero-photo { flex-shrink: 0; }
  
  .hero-icon {
    width: 200px;
    height: 200px;
    object-fit: contain;
    /* Optional: Rounded like profile if desired */
    border-radius: 50%; 
    background: #f9f9f9;
  }

  /* =========================================
     3. ESSAY LIST STYLES
     ========================================= */
  .essay-list {
    display: flex;
    flex-direction: column;
    max-width: 900px;
  }

  .essay-item {
    display: flex;
    gap: 3rem; 
    padding: 2.5rem 0; /* Breathing room */
    border-bottom: 1px solid #eee; 
    align-items: baseline;
  }

  .essay-item:last-child { border-bottom: none; }

  /* Date Column */
  .essay-meta {
    width: 120px;
    flex-shrink: 0;
  }

  .mono-date {
    font-family: monospace;
    font-size: 0.85rem;
    color: #888;
    display: block;
  }

  /* Content Column */
  .essay-content {
    flex: 1;
  }

  h3 {
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  /* 🛠️ TITLE LINK (Forced Blue) */
  .essay-link {
    font-size: 1.35rem; 
    font-weight: 700;
    color: #0067c0; /* 🎯 Academic Blue */
    text-decoration: none;
    display: block;
    transition: color 0.2s;
  }

  .essay-link:hover {
    color: #004b99; /* Darker blue hover */
    text-decoration: underline;
  }

  .essay-desc {
    font-size: 1.05rem;
    color: #555;
    line-height: 1.6;
    margin: 0 0 0.8rem 0; /* Space before "Coming Soon" */
  }

  /* 🛠️ "COMING SOON" ITALIC TEXT */
  .coming-soon {
    font-size: 0.95rem;
    font-style: italic;
    color: #888;
    display: block;
  }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .hero { flex-direction: column-reverse; align-items: flex-start; gap: 2rem; }
    .hero-icon { width: 120px; height: 120px; }
    .essay-item { flex-direction: column; gap: 0.5rem; }
    .essay-meta { width: 100%; }
  }
</style>
