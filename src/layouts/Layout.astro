---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
	title?: string;
}

const { title = "Anson Chan" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>

		<meta
			name="description"
			content="Designing trustworthy human-AI decision systems."
		/>
	</head>

	<body>
		<Navbar />

		<main class="main-content-wrapper">
			<slot />
		</main>

		<!-- FOOTER SECTION (Global) -->
		<footer class="site-footer">
			<div class="footer-container">
				
				<!-- Column 1: Contact Info -->
				<div class="footer-col">
					<h3>Contact Information</h3>
					
					<!-- Clean inline presentation for the email -->
					<div class="contact-group inline-layout">
						<span class="footer-label">Email:</span>
            <a href="mailto:tkc@cam.ac.uk" class="footer-link-inline">tkc@cam.ac.uk</a>
					</div>

					<div class="contact-group">
						<p class="footer-label">Location: </p>
						<p class="footer-text">
							Civil Engineering Building,<br>
							7a JJ Thomson Ave,<br>
							Cambridge, CB3 0FA
						</p>
					</div>
				</div>

				<!-- Column 2: Quick Links -->
				<div class="footer-col">
					<h3>Quick Links</h3>
					<ul class="footer-nav">
						<li><a href="/">Home</a></li>
						<li><a href="/research">Research</a></li>
						<li><a href="/projects">Projects</a></li>
						<li><a href="/writing">Essays</a></li>
					</ul>
				</div>

				<!-- Column 3: Connect -->
				<div class="footer-col">
					<h3>Connect</h3>
					<ul class="footer-nav">
						<li><a href="https://www.linkedin.com/in/anson-chan-b836331b9/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
						<li><a href="https://scholar.google.com/citations?user=hG0RMxAAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a></li>
						<li><a href="https://www.researchgate.net/profile/Anson-Chan-30" target="_blank" rel="noopener noreferrer">ResearchGate</a></li>
						<li><a href="https://github.com/ansontkchan" target="_blank" rel="noopener noreferrer">GitHub</a></li>
					</ul>
				</div>

			</div>

			<!-- Copyright Line -->
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} Anson Chan. Cambridge, United Kingdom.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
  /* 🛠️ CRITICAL FIX: Explicit global browser normalization overrides for GitHub Pages production builds */
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* 🎯 FORCES BULLETS TO DISAPPEAR ONLINE AND FIXES ALL OVERLAPS */
  ul, ol, .footer-nav {
    list-style: none !important; 
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  li {
    list-style: none !important;
  }

  .main-content-wrapper {
    flex: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    box-sizing: border-box;
  }

  /* =========================================
     COMPACT ACADEMIC FOOTER STYLES
     ========================================= */
  .site-footer {
    background: #fafafa;
    border-top: 1px solid #e5e5e5;
    padding: 2rem 0 1.5rem; 
    width: 100%;
    box-sizing: border-box;
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr; 
    gap: 3rem;
    box-sizing: border-box;
  }

  .footer-col h3 {
    font-size: 0.85rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 0.75rem 0; 
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-group {
    margin-bottom: 0.75rem; 
  }
  
  .contact-group:last-child {
    margin-bottom: 0;
  }

  .inline-layout {
    display: flex;
    align-items: baseline;
    gap: 0.4rem; 
  }

  .footer-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #666;
    text-transform: uppercase;
    margin: 0; 
  }

  .footer-text {
    font-size: 0.9rem;
    color: #444;
    line-height: 1.5;
    margin: 0;
  }

  .footer-link-inline {
    font-size: 0.9rem;
    color: #0067c0;
    text-decoration: none;
    font-weight: 600;
  }
  
  .footer-link-inline:hover { 
    text-decoration: underline; 
  }

  .footer-nav li {
    margin-bottom: 0.45rem; 
  }
  
  .footer-nav li:last-child {
    margin-bottom: 0;
  }

  .footer-nav a {
    font-size: 0.9rem;
    color: #0067c0;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }
  
  .footer-nav a:hover { 
    color: #004b99; 
    text-decoration: underline;
  }

  /* Bottom Copyright */
  .footer-bottom {
    max-width: 1100px;
    margin: 2rem auto 0;
    padding: 1.25rem 2rem 0; 
    border-top: 1px solid #e5e5e5;
    text-align: left;
    box-sizing: border-box;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: #888;
    margin: 0;
  }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    
    .footer-bottom {
      margin-top: 1.5rem;
      padding-top: 1rem;
    }
  }
</style>
