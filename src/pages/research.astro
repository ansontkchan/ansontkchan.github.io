---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Research">

  <main class="page-container">

    <!-- 1. INTRO HERO -->
    <section class="intro-block">
      <h1>Research</h1>
      <p class="intro-text">
        Buildings remain accountable for 37% of the global carbon emissions, reducing their carbon footprints is essential for the 2050 net zero target.
        How can trustworthy human-AI decision systems accelerate decarbonisation in the built environment?
        I combine advanced AI (agentic AI and RAG), decision science, and management theories to support decision-making towards sustainable construction.
      </p>
    </section>

    <!-- 2. RESEARCH HIGHLIGHTS GRID -->
    <section class="highlights-section">
      <h2 class="section-title">Research Highlights</h2>

      <div class="research-grid">

        <!-- Card 1: GREAT -->
        <article class="paper-card">
          <div class="image-box">
            <img src="/research/great/0.1-great-banner.png" alt="GREAT Framework" />
          </div>
          <div class="paper-content">
            <span class="status-pill status-yellow">User Evaluation</span>
            <h3>
              <!-- 🛠️ BLUE CLICKABLE TITLE -->
              <a href="/research/great" class="paper-link">
                GREAT (Green Retrofit Evidence-grounded Agent Team): Benchmarking Multi-agent RAG System
              </a>
            </h3>
            <p>
              This study develops a multi-agent RAG system, GREAT, to support green retrofitting planning. 
              We test how multi-agent RAG can improve answer accuracy by leveraging construction domain knowledge.
            </p>
            <!-- Tags -->
            <div class="tags-row">
              <span class="tech-tag">Multi-agent RAG</span>
              <span class="tech-tag">Reasoning</span>
              <span class="tech-tag">Expert Knowledge</span>
            </div>
          </div>
        </article>

        <!-- Card 2: Global Pathway -->
        <article class="paper-card">
          <div class="image-box">
            <img src="/research/global-pathway/0-cor-network.png" alt="Correlation Network" />
          </div>
          <div class="paper-content">
            <span class="status-pill status-green">Accepted · American Society of Civil Engineers (ASCE) Journal </span>
            <h3>
              <a href="/research/global-pathway" class="paper-link">
                A Global Pathway to Net Zero Buildings: A Correlation Network Analysis
              </a>
            </h3>
            <p>
              Achieving net zero requires better decisions. This project introduces "builtenv-cna", 
              an open-source analytical framework transforming 145 empirical surveys into correlation networks.
            </p>
            <div class="tags-row">
              <span class="tech-tag">Net-zero Decision Support</span>
              <span class="tech-tag">System Thinking</span>
              <span class="tech-tag">Open-source Python Analytical Tool</span>
              <span class="tech-tag">Graph-based networks</span>
            </div>
          </div>
        </article>

        <!-- Card 3: Disruptive Innovation -->
        <article class="paper-card">
          <div class="image-box">
            <img src="/research/disruptive-innov/0.3-DIT-banner.png" alt="Disruptive Innovation" />
          </div>
          <div class="paper-content">
            <span class="status-pill status-blue">Under Review</span>
            <h3>
              <a href="/research/disruptive-innov" class="paper-link">
                Disrupting the Undisruptable: Agentic AI Innovations in Construction
              </a>
            </h3>
            <p>
              Grounded in Disruptive Innovation Theory, this study explores how agentic AI challenges 
              innovation dynamics in the construction industry: a sector characterised by slow adoption and complex constraints.
            </p>
            <div class="tags-row">
              <span class="tech-tag">Technology Strategy</span>
              <span class="tech-tag">34 Interviews</span>
              <span class="tech-tag">Institution Innovation</span>
            </div>
          </div>
        </article>

        <!-- Card 4: Digital Twin -->
        <article class="paper-card">
          <div class="image-box">
            <img src="/research/DT-system/0-DTsystem-banner.png" alt="Digital Twin System" />
          </div>
          <div class="paper-content">
            <span class="status-pill status-green">Published · 2025 European Conference on Computing in Construction</span>
            <h3>
              <a href="/research/dt-system" class="paper-link">
                Convergence of Digital Twin and Human-Data Interaction: Advancing Customer Experience in the Built Environment
              </a>
            </h3>
            <p>
              Our 3-tiered framework with 26 user cases demonstrates how Digital Twin Systems 
              can be designed to enhance human-data interaction in the built environment.
            </p>
            <div class="tags-row">
              <span class="tech-tag">Industry 5.0</span>
              <span class="tech-tag">Digital Twin System</span>
              <span class="tech-tag">Human-Data Interaction</span>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- 3. ACADEMIC PROFILES -->
    <section class="profiles-section">
      <h2 class="section-title">Academic Profiles</h2>
      <div class="button-group">
        <a class="profile-btn" href="https://scholar.google.com/citations?user=hG0RMxAAAAAJ&hl=en" target="_blank">Google Scholar</a>
        <a class="profile-btn" href="https://github.com/ansontkchan" target="_blank">GitHub</a>
        <a class="profile-btn" href="https://www.linkedin.com/in/anson-chan-b836331b9/" target="_blank">LinkedIn</a>
        <a class="profile-btn" href="https://www.researchgate.net/profile/Anson-Chan-30" target="_blank">ResearchGate</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* =========================================
     1. STANDARD LAYOUT (1100px)
     ========================================= */
  .page-container {
    max-width: 1100px; /* 🎯 MATCHES HOMEPAGE */
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  .intro-block {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 4rem;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #111;
    letter-spacing: -0.02em;
  }

  .intro-text {
    font-size: 1.25rem;
    line-height: 1.7;
    color: #444;
    max-width: 800px;
  }

  /* =========================================
     2. GRID & CARDS
     ========================================= */
  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2.5rem;
    color: #111;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .paper-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease;
  }

  .paper-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }

  .image-box {
    width: 100%;
    height: 200px;       /* 🛠️ TALLER: Increased from 220px to 260px to give diagrams room */
    background: #ffffff; 
    border-bottom: 1px solid #eee;
    padding: 0;          /* 🛠️ REMOVED PADDING: Allows image to touch edges */
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .image-box img {
    width: 110%;
    height: 110%;
    object-fit: contain; /* Keeps the whole diagram visible */
    padding: 10px;       /* 🛠️ TINY GAP: Just enough so text doesn't hit the border */
    transition: transform 0.3s ease;
  }

  /* Optional: Slight zoom effect on hover to help readability */
  .paper-card:hover .image-box img {
    transform: scale(1.05);
  }

  .paper-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* =========================================
     3. TYPOGRAPHY & LINKS
     ========================================= */
  h3 {
    margin: 0 0 1rem 0;
    line-height: 1.35;
  }

  /* 🎯 ACADEMIC BLUE LINK STYLE */
  .paper-link {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
    transition: color 0.2s;
  }

  .paper-card:hover .paper-link {
    color: #0067c0; /* Turns blue on hover */
    text-decoration: underline;
  }

  p {
    font-size: 1rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 1.5rem;
  }

  /* =========================================
     4. BADGES & TAGS
     ========================================= */
  .status-pill {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1rem;
    align-self: flex-start;
  }

  .status-yellow { background: #fff4e5; color: #b45309; }
  .status-green { background: #e8f8ee; color: #18794e; }
  .status-blue { background: #e8f1ff; color: #2458d3; }

  .tags-row {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-size: 0.85rem;
    color: #666;
    background: #f3f4f6;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 500;
  }

  /* =========================================
     5. PROFILES SECTION
     ========================================= */
  .profiles-section {
    padding-top: 4rem;
    border-top: 1px solid #e5e5e5;
    margin-top: 4rem;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .profile-btn {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    font-weight: 600;
    background: #111;
    color: #fff;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .profile-btn:hover {
    background: #333;
  }

  @media (max-width: 900px) {
    .research-grid { grid-template-columns: 1fr; }
  }
</style>
