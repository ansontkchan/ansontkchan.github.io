---
import Layout from "../layouts/Layout.astro";
import projects from "../assets/projects.png"; 
---

<Layout title="Projects | Anson Chan">
<main class="page-container">
    
<!-- 1. HERO SECTION -->
<section class="hero">
<div class="hero-text">
<h1>From Research to Impacts</h1>
<p class="bio-text">
The below projects aim to bridge the gaps between rigorous research and AI impacts on society, with 3 key pillars:
(1) AI Governance & Public Policy, (2) AI Safety Evaluation, and (3) Responsible AI System Deployment.
</p>
</div>

<div class="hero-photo">
<img src={projects.src} alt="Three Pillars" class="project-logo" />
</div>
</section>

<!-- 2. STICKY SUB-NAV BAR -->
<nav class="sub-nav-bar">
<div class="sub-nav-links">
    <a href="#governance" class="sub-nav-item">AI Governance & Public Policy <span class="count">3</span></a>
    <a href="#safety" class="sub-nav-item">
    AI Safety Evaluation<span class="count">3</span></a>
    <a href="#deployment" class="sub-nav-item">Responsible AI System Deployment <span class="count">3</span></a>
</div>
</nav>

<!-- SECTION 1: AI GOVERNANCE -->
<section id="governance" class="project-section">
      
<div class="section-header">
<h2>🏦 AI Governance & Public Policy</h2>
<p>Enabling stakeholders to discuss emerging AI risks and governance structures through dialogues.</p>
</div>

<div class="cards-grid">
        
<!-- Grid 1 King's Politics -->
<article class="paper-card">
<div class="image-box">
<img src="/projects/kings-politics.png" alt="King's Politics" />
</div>

<div class="card-content">
<span class="mono-date">Apr-Dec/2025</span>
<h3><a href="https://www.linkedin.com/company/kings-politics/?viewAsMember=true" class="blue-link">King's Politics (Cambridge): Greater China Speakers Officer</a></h3>

    <ul>
    <li>A student-run policy discussion and speaker society based at King’s College, Cambridge.</li>
    <li>Moderated 10+ Fireside Chats/Speaker Events bridging technical AI and global AI governance.</li>
    <li>Advised on US-China AI and climate policy frameworks to enhance international cooperation.</li>
    </ul>

</div>
</article>

<!-- Grid 2 LLM+ Hub -->
<article class="paper-card">
<div class="image-box">
<img src="/projects/llm-plus.png" alt="LLM+ Hub" />
</div>

<div class="card-content">
<span class="mono-date">Jul 2025-Now</span>
<h3><a href="https://llmplus.ai/" target="_blank" class="blue-link">LLM+ Research Hub: Co-Founder/Research Fellow</a></h3>

    <ul>
    <li>7,000+ subscribers and 120+ members across the UK, China, US and Asia within 1 year of establishment.</li>
    <li>Strong research focus on AI4Science and AI adoption in organisations.</li>
    <li>Strategic parternships with 30+ top QS universities, AWS Amazon, Deutsche Bank and ASML.</li>
    </ul>
 </div>
</article>

<!-- Grid 3 EA-->
<article class="paper-card">
<div class="image-box">
<img src="/projects/ea.png" alt="Effective Altruism" />
</div>

<div class="card-content">
<span class="mono-date">Flagship Easter Fellowship/2026</span>
<h3><a href="https://www.eacambridge.org/ea-fellowship" class="blue-link">Cambridge Effective Altruism: Research Fellow</a></h3>

    <ul>
    <li>An 8-week student fellowship with <a href="https://chirpresearchprogram.squarespace.com/" class="blue-link">Cambridge High Impact Research Project</a> to tackle policy-relevant research questions.</li>       
    <li>Arguing "what are the most effective ways that I can help others and why?".</li>
    <li>Forecast the probability of real biosecurity and AI risks.</li>
    </ul>

</div>
</article>

</div>
</section>

<!-- SECTION 2: AI SAFETY -->
<section id="safety" class="project-section">
<div class="section-header">
<h2>🛡️ AI Safety Evaluation</h2>
<p>Evaluating the impacts of advanced AI to advance AI safety guardrail developments.</p>
</div>

<div class="cards-grid">

<!-- Grid 1 Oxbridge AI X-->
<article class="paper-card">
<div class="image-box">
<img src="/projects/oxbridge-ai.png" alt="Oxbridge AI X" />
</div>

<div class="card-content">
<span class="mono-date">Oct 2025–Now</span>
<h3><a href="https://www.oxbridgeaix.uk/" target="_blank" class="blue-link">Oxbridge AI X: Member</a></h3>

    <ul>
    <li>Gaining hands-on experience on the practical side of AI safety with 120+ industry mentors.</li>       
    <li>Cross-university collaboration with Oxford counterparts from ideation, pitching, competition, and entrepreneurship</li>
    </ul>

</div>
</article>

<!-- Grid 2 CAISH-->
<article class="paper-card">
<div class="image-box">
<img src="/projects/caish.png" alt="Cambridge AI Safety Hub" />
</div>

<div class="card-content">
<span class="mono-date">Apr 2026-Now</span>
<h3><a href="https://caish.org/" class="blue-link">Cambridge AI Safety Hub: Member/Research Fellow</a></h3>

    <ul>
    <li>Writing papers, coding, and working on problems about AI safety and superintelligence.</li>       
    <li>Carrying out AI safety and societal alignment projects with a focus on existential risks.</li>
    <li>UK AI Policy course.</li>
    </ul>

</div>
</article>

<!-- Grid 3 Thinking about thinking -->
<article class="paper-card">
<div class="image-box">
<img src="/projects/tat.png" alt="Thinking about thinking" />
</div>

<div class="card-content">
<span class="mono-date">Jul 2026-Now</span>
<h3><a href="https://www.thinkingaboutthinking.org/about" class="blue-link">Thinking About Thinking: Research Fellow</a></h3>

    <ul>
    <li>Fellowship leading discussion on how intelligence, artificial, biological and collective, is studied, built and governed.</li>       
    <li>Multi-disciplinary forum across AI, neuroscience, computer science, mathematics and the sciences of mind.</li>
    <li>Involved in participating experiments and research projects.</li>
    </ul>

</div>
</article>

</div>
</section>

<!--SECTION 3: DEPLOYMENT -->
<section id="deployment" class="project-section">   
<div class="section-header">
<h2>🧊 Responsible AI System Deployment</h2>
<p>Carrying out market research or joining hackathons to understand AI applications and challenges.</p>
</div>

<div class="cards-grid">
        
<!-- Grid 1 Bacbudy-->
<article class="paper-card">
<div class="image-box">
<img src="/projects/bacbudy.png" alt="Bacbudy" />
</div>

<div class="card-content">
<span class="mono-date">2025-Now</span>
<h3><a href="https://www.youtube.com/watch?v=dD-SUN3_Org" target="_blank" class="blue-link">Bacbudy Embodied AI Exosuit: AI Scientist</a></h3>

    <ul>
    <li>Champion: <a href="https://www.linkedin.com/posts/anson-chan-b836331b9_bacbudy-exosuit-embodied-ugcPost-7341224502325874688-ViGq/?utm_source=share&utm_medium=member_desktop&rcm=ACoAADLRJdMBPXJtMRMbGGzOcZxwgVTWI7wMIYI" target="_blank" class="blue-link">Cambridge BuildHouse x NVIDIA Deep Learning Institute</a></li>       
    (1st cohort, June/2025).
    <li>Bacbudy is a lightweight, soft robotic exosuit designed to protect and support the user's lower back.</li>
    <li> Secured USD 4.5K funding from Hong Kong PolyU and Hong Kong Science and Technology Park.</li>
    </ul>

</div>
</article>

<!-- Grid 2 AI Engine-->
<article class="paper-card">
<div class="image-box">
<img src="/projects/ai-engine.png" alt="AI Engine" />
</div>

<div class="card-content">
<span class="mono-date">Feb 2025</span>
<h3><a href="https://www.aiengine.build/" class="blue-link">AI Engine Hackathon: Inaugural Hacker/Technology Lead</a></h3>

    <ul>
    <li>A 2-day hackathon with over 200 UK top engineers to work on AI projects.</li>       
    <li>Supported by Bessemer, Chapter One, Dawn Capital, and Seedcamp and collaborated with top-tier UK universities.</li>
    <li>Developed a prototype to incorporate APIs, GIS and multiple AI software as a next-generation Google Map.</li>
    </ul>

</div>
</article>

<!-- Grid 3 LLM Venture-->
<article class="paper-card">
<div class="image-box">
<img src="/projects/iteams.png" alt="iTeams" />
</div>

<div class="card-content">
<span class="mono-date">Apr 2026-Now</span>
<h3><a href="https://iteamsonline.org/cambridge-i-teams/" target="_blank" class="blue-link">Cambridge iTeams: LLMVenture Inventor</a></h3>

    <ul>
    <li><a href="https://llmventure.com/" target="_blank" class="blue-link">LLMVenture</a> is an intelligence platform to support investors evaluating AI startup ideas and pitch decks.</li>       
    <li>The platform is built against a proprietary dataset of 4,549 real GenAI and LLM ventures worldwide.</li>
    <li>LLM+ collaborate with Cambridge iTeams to validate and commerialise LLMVenture through market research.</li>
    </ul>

</div>
</article>

        

      </div>
    </section>

  </main>
</Layout>

<style>
  /* =========================================
     1. PAGE LAYOUT
     ========================================= */
  .page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  /* =========================================
     2. HERO SECTION (Synced with Homepage)
     ========================================= */
  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 5rem;
    padding: 5rem 0 4rem; /* Reduced bottom padding */
    /* 🛠️ FIX: REMOVED border-bottom */
    margin-bottom: 2rem;
  }

  .hero-text {
    flex: 1;
    max-width: 680px;
  }

  .hero-text h1 {
    font-size: 3rem;  /* 🎯 Matches Homepage */
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: #111;
  }
  
  .bio-text {
    font-size: 1.15rem; /* 🎯 Matches Homepage */
    color: #444;
    line-height: 1.7;
    margin-bottom: 0;
  }

  .hero-photo { flex-shrink: 0; }

  /* 🛠️ FIX: Smaller Logo Size */
  .project-logo {
    width:275px;
    height: auto;
    object-fit: contain;
  }

  /* =========================================
     3. STICKY SUB-NAV
     ========================================= */
  .sub-nav-bar {
    position: sticky;
    top: 0;
    background: rgba(250, 248, 245, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;
    border-bottom: 1px solid #e5e5e5;
    padding: 1rem 0;
    margin-bottom: 4rem;
  }

  .sub-nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .sub-nav-item {
    font-size: 1rem;
    font-weight: 600;
    color: #666;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s;
  }

  .sub-nav-item:hover { color: #0067c0; }

  .count {
    font-size: 0.75rem;
    background: #e5e5e5;
    color: #555;
    padding: 0.1rem 0.4rem;
    border-radius: 10px;
    font-weight: 500;
  }

  /* =========================================
     4. GRID SECTIONS
     ========================================= */
  .project-section {
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid #e5e5e5; /* The divider line */
    scroll-margin-top: 6rem;
  }

  .project-section:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-size: 2.2rem; /* Matches Research */
    font-weight: 700;
    color: #111;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    font-size: 1.1rem;
    color: #555;
    margin: 0;
    max-width: 800px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* =========================================
     5. CARD STYLES
     ========================================= */
  .paper-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }

  .paper-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }

  .image-box {
    width: 100%;
    height: 180px;
    background: #f9f9f9;
    border-bottom: 1px solid #eee;
  }

  .image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .mono-date {
    font-family: monospace;
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 0.8rem;
    font-weight: 500;
  }

  h3 {
    margin: 0 0 0.8rem 0;
    font-size: 1.1rem;
    line-height: 1.35;
  }

  p {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 1.5rem; /* Space for Read More */
    flex-grow: 1;
  }

  .blue-link {
    font-weight: 700;
    color: #0067c0; 
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .blue-link:hover { 
    color:  #004b99;
    text-decoration: underline; 
  }

  /* 🛠️ NEW: Read More Button */
  .read-more-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0067c0;
    text-decoration: none;
    margin-top: auto;
  }

  .read-more-link:hover {
    text-decoration: underline;
    color: #004b99;
  }

  /* MOBILE */
  @media (max-width: 900px) {
    .hero { flex-direction: column-reverse; align-items: flex-start; gap: 2rem; }
    .project-logo { width: 120px; }
    .cards-grid { grid-template-columns: 1fr; }
    .sub-nav-links { flex-wrap: wrap; gap: 1rem; }
  }
</style>
