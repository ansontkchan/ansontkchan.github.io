---
import Layout from "../layouts/Layout.astro";
import profile from "../assets/profile.jpg";

import trust from "../assets/trust.png";
import decision from "../assets/decision.png";
import sust from "../assets/sust.png";
import tech from "../assets/tech.png";
---

<Layout title="Anson Chan">

<section class="hero">

<div class="hero-text">

<h1>Designing Trustworthy Human–AI Decision Systems</h1>

<p class="affiliation">
  <strong>PhD Researcher</strong> · <strong>University of Cambridge</strong> · <strong>Department of Engineering</strong>
</p>

<p>
  I study how humans and increasingly capable AI systems can make trustworthy decisions together.
  My current research uses green buildings and smart cities as the real-world laboratory for designing
  trustworthy human–AI decision systems. Ultimately, I am interested in how people should think, decide, and govern
  in an age of increasingly capable AI.
</p>
<a href="/research" class="hero-button">
  Current Research →
</a>

</div>

<div class="hero-photo">
  	<img
    src={profile.src}
    alt="Portrait of Anson Chan"
    class="profile-photo"
	/>
</div>

</section>

<section class="research-vision">

<h2>Research Themes</h2>

<div class="vision-grid">

<article class="vision-item">

  <div class="logo-box">

  <img 
        src={trust.src}
        alt="Trustworthy AI"
        class="theme-logo"
  />
  </div>
    
    <h3>Trustworthy AI</h3>

    <p>
      Designing advanced AI systems that are transparent and reliable.
    </p>

    <a href="/research/trustworthy-ai">Read more →</a>
  </article>

  <article class="vision-item">
    
    <div class="logo-box">

    <img 
        src={decision.src}
        alt="Decision Intelligence"
        class="theme-logo"
    />
    </div>
    
    <h3>Decision Intelligence</h3>

    <p>
      Developing data analysis tools to support complex decision-making.
    </p>

    <a href="/research/decision-intelligence">Read more →</a>
  </article>

  <article class="vision-item">

    <div class="logo-box">

    <img 
        src={sust.src}
        alt="Sustainable Cities"
        class="theme-logo"
    />
    </div>
    
    <h3>Sustainable Cities</h3>

    <p>
      Investigating sustainability principles in buildings and cities.
    </p>

    <a href="/research/sust-cities">Read more →</a>
  </article>

  <article class="vision-item">

  <div class="logo-box">

  <img 
        src={tech.src}
        alt="Technology & Society"
        class="theme-logo"
  />
  </div>

    <h3>Technology & Society </h3>

    <p>
      Understanding how technologies reshape societies.
    </p>

    <a href="/research/tech-society">Read more →</a>
  </article>

</div>
</section>

<section class="research-vision">

<h2>Musing</h2>

<p class="personal">
  Beyond my research, I write about technologies, philosophy, cities, and ideas that shape humanities.
</p>
<a href="/writing" class="hero-button">
  Writing →
</a>

</section>

</Layout>