---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Systems & Impact | Anson Chan">
  <main class="homepage-container">
    
    <!-- PAGE HERO FRAME (REFRAMED FOR FELLOWSHIP STANDARDS) -->
    <header class="section-block page-intro">
      <h1 class="section-title">Systems, Deployment & Impact</h1>
      <p class="subtitle-text">
        Translating microeconomic primitives, socio-technical alignment protocols, and empirical policy frameworks into verifiable infrastructure.
      </p>
    </header>

    <!-- SECTION 1: APPLIED SYSTEMIC VENTURES -->
    <section class="section-block">
      <h2 class="sub-section-title">Institutional Systems & Platforms</h2>
      <div class="ventures-premium-grid">
        
        <!-- CARD 1: LLM+ -->
        <article class="fellowship-card">
          <div class="card-logo-header">
            <!-- 🎯 RENDER IMAGE PATH: Adjust source string to match your assets folder -->
            <img src="/images/llm-plus-logo.png" alt="LLM+ Research Hub Logo" class="brand-logo-img" />
          </div>
          <div class="card-body-content">
            <div class="card-meta-row">
              <span class="badge-tag tag-purple">Socio-Technical Node</span>
              <span class="chrono-stamp">2025 - Present</span>
            </div>
            <h3 class="card-title-heading">LLM+ Research Hub</h3>
            <p class="card-brief">
              Co-founded an international AI-for-Science research collective spanning 120+ researchers across 30 world-leading institutions. Architected <strong>LLMVenture</strong>, a socio-economic analytics engine that audited 4,500+ generative AI ventures to map technological diffusion and systemic labor transformations.
            </p>
            <div class="card-action-footer">
              <a href="https://llmplus.ai" target="_blank" rel="noopener noreferrer" class="blue-link">Explore llmplus.ai &rarr;</a>
            </div>
          </div>
        </article>

        <!-- CARD 2: BACBUDY -->
        <article class="fellowship-card">
          <div class="card-logo-header">
            <!-- 🎯 RENDER IMAGE PATH: Adjust source string to match your assets folder -->
            <img src="/images/bacbudy-logo.png" alt="BacBudy Embodied AI Logo" class="brand-logo-img" />
          </div>
          <div class="card-body-content">
            <div class="card-meta-row">
              <span class="badge-tag tag-blue">Embodied Economics</span>
              <span class="chrono-stamp">2025 - Present</span>
            </div>
            <h3 class="card-title-heading">BacBudy</h3>
            <p class="card-brief">
              Co-founded as AI Scientist, developing an embodied intelligence apparel matrix to safeguard industrial labor demographics against physical strain. Integrated deep learning feedback structures with workplace economics to construct scalable safety-critical workflows.
            </p>
            <div class="card-action-footer">
              <span class="award-callout">🏆 Champion — Cambridge Buildhouse x NVIDIA Startup Pitch</span>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- SECTION 2: FRONTIER ALIGNMENT FELLOWSHIPS -->
    <section class="section-block">
      <h2 class="sub-section-title">Frontier Safety & Governance</h2>
      <div class="ventures-premium-grid">
        
        <!-- CARD 3: CAISH -->
        <article class="fellowship-card">
          <div class="card-logo-header">
            <img src="/images/caish-logo.png" alt="Cambridge AI Safety Hub Logo" class="brand-logo-img" />
          </div>
          <div class="card-body-content">
            <div class="card-meta-row">
              <span class="badge-tag tag-red">AI Alignment</span>
              <span class="chrono-stamp">2024 - Present</span>
            </div>
            <h3 class="card-title-heading">Cambridge AI Safety Hub (CAISH)</h3>
            <p class="card-brief">
              Active Fellow contributing to the technical and institutional alignment ecosystem. Developing empirical frameworks to assess risks associated with high-stakes autonomous decision-making and exploring mechanism design to optimize multi-agent systemic stability.
            </p>
            <div class="card-action-footer">
              <a href="https://caish.org" target="_blank" rel="noopener noreferrer" class="blue-link">Explore caish.org &rarr;</a>
            </div>
          </div>
        </article>

        <!-- CARD 4: KING'S POLITICS ORG LOGIC -->
        <article class="fellowship-card">
          <div class="card-logo-header">
            <img src="/images/kings-politics-logo.png" alt="King's College Politics Society Logo" class="brand-logo-img" />
          </div>
          <div class="card-body-content">
            <div class="card-meta-row">
              <span class="badge-tag tag-green">Policy Architecture</span>
              <span class="chrono-stamp">2024 - Present</span>
            </div>
            <h3 class="card-title-heading">King's College Politics Society</h3>
            <p class="card-brief">
              Serving as Events Officer for Greater China and Hong Kong. Convened multi-disciplinary tracking nodes to connect frontier technical breakthroughs with macro-economic metrics, global environmental governance models, and sovereign policy.
            </p>
            <div class="card-action-footer">
              <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="blue-link">Official Network Profile &rarr;</a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- SECTION 3: THE ANTHROPIC-STYLE VERTICAL FEED -->
    <section class="section-block">
      <h2 class="sub-section-title">Socio-Technical Dialogues & Research Briefs</h2>
      <p class="feed-intro-text">A chronological index of convened forums addressing macro-level risk mitigation, structural economic realignment, and international governance systems.</p>
      
      <div class="impact-chronology-feed">
        
        <!-- LOG ITEM 1 -->
        <div class="feed-impact-row">
          <div class="feed-poster-column">
            <!-- 🎯 DROP POSTER: Replace path with your official event image asset -->
            <img src="/images/posters/earthquake-management.jpg" alt="AI for Post-Earthquake Management Poster" class="poster-asset-img" />
            <div class="poster-backup-fallback">Poster Asset Node</div>
          </div>
          <div class="feed-description-column">
            <div class="feed-meta-strip">
              <span class="badge-mini type-keynote">Keynote Address</span>
              <span class="date-mono">19 May 2026</span>
            </div>
            <h4>AI for Post-Earthquake Management</h4>
            <p class="feed-institution">University of Cambridge & Pontificia Universidad Cat&oacute;lica del Peru</p>
            <p class="feed-abstract">Presented optimization algorithms for critical emergency response infrastructures. Addressed the challenge of routing computational agents through dynamic, resource-constrained environments during systemic crisises.</p>
          </div>
        </div>

        <!-- LOG ITEM 2 -->
        <div class="feed-impact-row">
          <div class="feed-poster-column">
            <img src="/images/posters/climate-decision.jpg" alt="Climate Decision Making Poster" class="poster-asset-img" />
            <div class="poster-backup-fallback">Poster Asset Node</div>
          </div>
          <div class="feed-description-column">
            <div class="feed-meta-strip">
              <span class="badge-mini type-chat">LLM+ Fireside</span>
              <span class="date-mono">29 Jan 2026</span>
            </div>
            <h4>Climate Decision-making and Governance in the Age of GenAI</h4>
            <p class="feed-institution">In conversation with Dr. Angel Hsu (University of North Carolina at Chapel Hill)</p>
            <p class="feed-abstract">Analyzed the intersection of algorithmic transparency and international environmental policy. Evaluated how data asymmetries in frontier models complicate cross-border carbon accounting systems and carbon credit governance.</p>
          </div>
        </div>

        <!-- LOG ITEM 3 -->
        <div class="feed-impact-row">
          <div class="feed-poster-column">
            <img src="/images/posters/green-retrofitting.jpg" alt="Agentic AI and Green Retrofitting Poster" class="poster-asset-img" />
            <div class="poster-backup-fallback">Poster Asset Node</div>
          </div>
          <div class="feed-description-column">
            <div class="feed-meta-strip">
              <span class="badge-mini type-keynote">Invited Keynote</span>
              <span class="date-mono">19 Dec 2025</span>
            </div>
            <h4>Agentic AI and Green Retrofitting</h4>
            <p class="feed-institution">Hong Kong Polytechnic University: Department of Building and Real Estate</p>
            <p class="feed-abstract">Outlined algorithmic structures that simulate long-range resource consumption in urban areas. Suggested data-driven frameworks for managing systemic risk in sustainable real estate investments.</p>
          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>

<!-- STYLESHEET EXCLUSIVELY REMODALED TO MATCH ANTHROPIC/CAISH PLATFORMS -->
<style>
  /* =========================================
     1. CARD STRUCTURE & HOVER EFFECTS
     ========================================= */
  .fellowship-card { 
    background: #ffffff; 
    border: 1px solid #e2e8f0; 
    border-radius: 14px; 
    overflow: hidden; 
    display: flex; 
    flex-direction: column; 
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1); 
    box-shadow: 0 4px 20px rgba(0,0,0,0.01); 
  }
  
  .fellowship-card:hover { 
    transform: translateY(-4px); 
    box-shadow: 0 16px 36px rgba(0,0,0,0.06); 
    border-color: #cbd5e1; 
  }

  /* =========================================
     2. STANDARDIZED BRAND LOGO FRAMES
     ========================================= */
  .card-logo-header { 
    width: 100%; 
    height: 140px; 
    background: #ffffff; 
    border-bottom: 1px solid #f1f5f9; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    padding: 1.5rem; 
  }
  
  .brand-logo-img { 
    max-width: 70%; 
    max-height: 75%; 
    object-fit: contain; 
    filter: grayscale(10%) contrast(95%); 
    transition: filter 0.2s ease; 
  }
  
  .fellowship-card:hover .brand-logo-img { 
    filter: grayscale(0%) contrast(100%); 
  }

  /* =========================================
     3. CARD INTERIORS & METRICS
     ========================================= */
  .card-body-content { 
    padding: 2rem; 
    display: flex; 
    flex-direction: column; 
    flex-grow: 1; 
  }
  
  .card-meta-row { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 1rem; 
  }
  
  .badge-tag { 
    font-size: 0.72rem; 
    font-weight: 700; 
    text-transform: uppercase; 
    letter-spacing: 0.04em; 
    padding: 0.25rem 0.6rem; 
    border-radius: 6px; 
  }
  
  .tag-purple { background: #f3e8ff; color: #6b21a8; }
  .tag-blue { background: #e0f2fe; color: #0369a1; }
  .tag-red { background: #fee2e2; color: #991b1b; }
  .tag-green { background: #dcfce7; color: #166534; }
  
  .chrono-stamp { 
    font-family: monospace; 
    font-size: 0.85rem; 
    color: #64748b; 
  }
  
  .card-title-heading { 
    font-size: 1.35rem; 
    font-weight: 700; 
    margin-bottom: 0.75rem; 
    color: #111; 
    letter-spacing: -0.01em; 
  }
  
  .card-brief { 
    font-size: 0.95rem; 
    color: #334155; 
    line-height: 1.6; 
    margin-bottom: 1.8rem; 
    flex-grow: 1; 
  }
  
  .card-action-footer { 
    border-top: 1px solid #f1f5f9; 
    padding-top: 1.2rem; 
  }
  
  .award-callout { 
    font-size: 0.85rem; 
    font-weight: 600; 
    color: #b45309; 
  }

  /* =========================================
     4. ANTHROPIC/MCKINSEY-STYLE IMPACT FEED
     ========================================= */
  .feed-intro-text { 
    font-size: 1.05rem; 
    color: #64748b; 
    margin-top: -1.5rem; 
    margin-bottom: 3rem; 
    max-width: 700px; 
  }
  
  .impact-chronology-feed { 
    display: flex; 
    flex-direction: column; 
    gap: 3.5rem; 
  }
  
  .feed-impact-row { 
    display: grid; 
    grid-template-columns: 200px 1fr; 
    gap: 3rem; 
    border-bottom: 1px solid #f1f5f9; 
    padding-bottom: 3.5rem; 
    position: relative; 
  }
  
  .feed-impact-row:last-child { 
    border-bottom: none; 
  }

  /* =========================================
     5. AUTOMATED POSTER GRAPHICS CONTROLLERS
     ========================================= */
  .feed-poster-column { 
    width: 100%; 
    aspect-ratio: 3/4; 
    background: #f8fafc; 
    border: 1px solid #e2e8f0; 
    border-radius: 8px; 
    overflow: hidden; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    position: relative; 
  }
  
  .poster-asset-img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    position: absolute; 
    top: 0; 
    left: 0; 
    z-index: 2; 
  }
  
  .poster-backup-fallback { 
    font-size: 0.72rem; 
    color: #94a3b8; 
    font-family: monospace; 
    text-align: center; 
    padding: 1rem; 
    z-index: 1; 
  }

  /* =========================================
     6. FEED TYPOGRAPHY & CHRONOLOGY METRICS
     ========================================= */
  .feed-description-column h4 { 
    font-size: 1.2rem; 
    font-weight: 700; 
    margin: 0.6rem 0 0.3rem 0; 
    color: #111; 
    letter-spacing: -0.01em; 
  }
  
  .feed-institution { 
    font-size: 0.92rem; 
    font-weight: 600; 
    color: #475569; 
    margin: 0 0 1rem 0; 
  }
  
  .feed-abstract { 
    font-size: 0.95rem; 
    color: #334155; 
    line-height: 1.6; 
    margin: 0; 
  }
  
  .feed-meta-strip { 
    display: flex; 
    gap: 1rem; 
    align-items: center; 
  }
  
  .badge-mini { 
    font-size: 0.65rem; 
    font-weight: 700; 
    padding: 0.2rem 0.5rem; 
    border-radius: 4px; 
    text-transform: uppercase; 
    letter-spacing: 0.02em; 
  }
  
  .type-keynote { 
    background: #fef3c7; 
    color: #d97706; 
    border: 1px solid #fde68a; 
  }
  
  .type-chat { 
    background: #f0fdf4; 
    color: #166534; 
    border: 1px solid #bbf7d0; 
  }
  
  .date-mono { 
    font-family: monospace; 
    font-size: 0.85rem; 
    color: #64748b; 
  }

  /* =========================================
     7. MULTI-DEVICE RESPONSIVE BREAKPOINTS
     ========================================= */
  @media (max-width: 900px) {
    .ventures-premium-grid { 
      grid-template-columns: 1fr; 
      gap: 2rem; 
    }
    .feed-impact-row { 
      grid-template-columns: 1fr; 
      gap: 1.5rem; 
      padding-bottom: 2.5rem; 
    }
    .feed-poster-column { 
      max-width: 180px; 
    }
  }
</style>

