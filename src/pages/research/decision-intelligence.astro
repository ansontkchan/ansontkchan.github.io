---
import Layout from "../../layouts/Layout.astro";
import decision from "../../assets/decision.png";
---

<Layout title="Decision Intelligence">
  <main class="page-container">
    
    <!-- HERO SECTION -->
    <section class="theme-hero-section">
      <div class="hero-content">
        <h1>Decision Intelligence</h1>
        <p>
          Developing data analysis tools to support decision-making.
        </p>
      </div>

      <div class="hero-image-container">
        <img
          src={decision.src}
          alt="Decision Intelligence"
          class="hero-icon"
        />
      </div>
    </section>

    <!-- STICKY SUB-NAV BAR -->
    <nav class="sub-nav-bar">
      <div class="sub-nav-links">
        <a href="#independent" class="sub-nav-item">
          Independent Research <span class="count">2</span>
        </a>
        <a href="#collaborative" class="sub-nav-item">
          Collaborative Research <span class="count">2</span>
        </a>
      </div>
    </nav>

    <!-- SECTION 1: Independent Research (Clean: No Tags) -->
    
    <div class="content-grid" id="independent">
      <aside class="sidebar">
        <h2>Independent Research</h2>
      </aside>

      <div class="project-list">
        <!-- Project 1 -->
        <div class="project-card">
          <h3>
            <a href="/research/global-pathway">    
            A Global Pathway to Net Zero Buildings:
            A Correlation Network Analysis of Building Information Modelling (BIM)-based Whole Life Carbon Assessment Challenges
            </a>
          </h3>
          <p>
          Apart from analysing descriptive statistics, such as mean scores, collected from questionnaries,
          how can we use system thinking to make smarter decisions? 
          A graph-based research and policy toolkit, builtenv-cna, is developed and tested with 145 survey responses from over 20 countries.
          </p>
        </div>


        <!-- Project 2 -->
        <div class="project-card">
          <h3>
            <a href="https://github.com/ansontkchan/Global_Female_Wanderers_Nomad_TravelApp">    
            Nomad:
            A Travel App for Global Female Wanderers
            </a>
          </h3>
          <p>
          Developed an app for female solo travelers to explore the world safely and sustainably with carbon footprint measurements,
          MBTI matching, LLM-generated travelling plans, and real-time travel partner chatting functions.
   
          <ul class="structured-bullets">
          <li><strong>Role & Affiliation:</strong> Technology Lead, <a href="https://www.murrayedwards.cam.ac.uk/enterprising-women/she-starts" target="_blank" rel="noopener nonreferrer" class="external-link"> 
            University of Cambridge, Murray Edward College: 1st cohort of Enterprising Women - She Starts Programme</a></li>

    <li><strong>Project Scope:</strong> A 2-day intensive programme for women students to develop and pitch business ideas focused on female healthcare.</li>
    <li><strong>Key Contributions:</strong> As the Technology Lead, I developed the full-stack frontend and backend for the travelling app.</li>
    </ul>

          </p>
        </div>
        </div>
    </div>

<!-- SECTION 2: Collaborative Research (Structured Bullets) -->
    <div class="content-grid" id="collaborative">
      <aside class="sidebar">
        <h2>Collaborative Research</h2>
      </aside>

      <div class="project-list">
    
<!-- 1. Oxford Net Zero Tracker -->
    <div class="project-card">      
    <h3>
    <a href="https://zerotracker.net/" target="_blank" rel="noopener noreferrer">
    Net Zero Tracker
    </a>
    </h3>

    <p>
    We all know that net zero targets are critical, but do we know how are we doing? How are companies and governments progressing?
    </p>
    
    <ul class="structured-bullets">
    <li><strong>Role & Affiliation:</strong> Volunteer Technical Contributor, 
    <a href="https://zerotracker.net/" target="_blank" rel="noopener nonreferrer" class="external-link"> Net Zero Tracker</a> and

    <a href="https://chatnetzero.ai/about/" target="_blank" rel="noopener nonreferrer" class="external-link"> Chat Net Zero</a> (Ongoing research).
    </li>

    <li><strong>Project Scope:</strong> Analysing net zero targets in all nations that are parties to the UNFCCC, 
    every region in the largest 25 emitting nations, 
    all cities with more than 500,000 inhabitants, and the world's largest 2,000 publicly listed companies by annual revenue.</li>
    <li><strong>Key Contributions:</strong> Assisted in merging LLMs and expert-level net zero knowledge to enable reporting in COP28 and COP29, education,
    fact-checking, research and benchmarking</li>
    </ul>
        </div>

<!-- 2.Esther Yung Elderly -->
    <div class="project-card">
    <h3>
    <a href="https://www.sciencedirect.com/science/article/pii/S0264275125000381" target="_blank" rel="noopener noreferrer">
    Considerations of Planning Community Facilities and Elderly Neighbourhood Satisfaction in Urban Old District
    </a>
    </h3>
    
    <p>
    A capability approach framework for community facilities to promote older adults' well-being.
    </p>
    
    <ul class="structured-bullets">
    <li><strong>Role & Affiliation:</strong> Part-time Research Assistant, 
        Hong Kong University Grants Committee General Research Fund; 
        Principal Investigator: <a href="https://www.polyu.edu.hk/cmi/people/academic-staff/dr-esther-hk-yung/" target="_blank" 
        rel="noopener noreferrer" class="external-link"> Dr Esther YUNG </a>, the Hong Kong Polytechnic University 
        (2019 – 2022).
    </li>
    
    <li><strong>Project Scope:</strong> Applying spatial analysis and qualitative research methods to analyse the complex 
        relationships among community facility provision, older adults' usage and well-being.</li>
    <li><strong>Key Contributions:</strong> Carried out interviews with the elderly in Hong Kong and prepared the transcripts for analysis.</li>
    </ul>
        
    </div>
    </div>
    </div>
  </main>
</Layout>

<style>
  /* =========================================
     1. PAGE LAYOUT & GEOMETRY
     ========================================= */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  /* =========================================
     2. HERO SECTION (Side-by-Side)
     ========================================= */
  .theme-hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    padding: 4rem 0 1.5rem;
  }

  .hero-content {
    flex: 1;
    max-width: 650px;
  }

  .hero-content h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #111;
  }

  .hero-content p {
    font-size: 1.2rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }

  .hero-image-container {
    flex-shrink: 0;
    width: 240px;
  }

  .hero-icon {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* =========================================
     3. STICKY SUB-NAVIGATION BAR
     ========================================= */
  .sub-nav-bar {
    position: sticky;
    top: 0;
    background: rgba(250, 248, 245, 0.95); /* Slight transparency */
    backdrop-filter: blur(10px);           /* Blurs content behind it */
    z-index: 100;
    border-bottom: 1px solid #e5e5e5;
    padding: 1rem 0;
    margin-bottom: 3.5rem;
  }

  .sub-nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .sub-nav-item {
    font-size: 1rem;
    font-weight: 600;
    color: #666;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s;
  }

  .sub-nav-item:hover {
    color: #0067c0;
  }

  .sub-nav-item .count {
    font-size: 0.75rem;
    background: #e5e5e5;
    color: #555;
    padding: 0.1rem 0.4rem;
    border-radius: 10px;
    font-weight: 500;
  }

  /* =========================================
     4. CONTENT GRIDS (Sidebar + List)
     ========================================= */
  .content-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 4rem;
    padding-bottom: 2rem;       
    margin-bottom: 2rem;        
    border-bottom: 1px solid #e5e5e5; 
    scroll-margin-top: 6rem; /* Ensures sticky nav doesn't cover title when clicked */
  }

  .content-grid:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .sidebar h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #222;
    position: sticky;
    top: 5rem;
    margin: -0.2rem 0 0 0;
  }

  /* =========================================
     5. PROJECT CARDS & TYPOGRAPHY
     ========================================= */
  .project-card {
    padding: 2.5rem 0;
    border-top: 1px solid #e5e5e5;
  }
  
  .project-card:first-child {
    border-top: none;
    padding-top: 0;
  }

  .project-card h3 {
    margin: 0 0 0.75rem;
  }

  .project-card h3 a {
    color: #0067c0;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .project-card h3 a:hover {
    text-decoration: underline;
  }

  .project-card p {
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  /* =========================================
     6. COLLAB LISTS & LINKS (New Updates)
     ========================================= */
  .structured-bullets {
    margin: 1.25rem 0 0 0;
    padding-left: 1.2rem;
    list-style-type: square;
  }

  .structured-bullets li {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .structured-bullets strong {
    color: #222;
    font-weight: 600;
  }

  /* The Specific "Academic Blue" Link Style for LLM+ */
  .external-link {
    color: #0067c0;  /* Matches Main Title Blue exactly */
    font-weight: 700;
    text-decoration: none;
  }

  .external-link:hover {
    text-decoration: underline;
    color: #004b99;
  }

  /* =========================================
     7. MOBILE RESPONSIVE
     ========================================= */
  @media (max-width: 900px) {
    .theme-hero-section {
      flex-direction: column-reverse; /* Stacks image on top */
      align-items: flex-start;
      gap: 2rem;
      padding: 3rem 0 1rem;
    }

    .content-grid {
      grid-template-columns: 1fr; /* Stacks sidebar above list */
      gap: 1rem;
    }

    .sidebar h2 {
      position: static;
      border-bottom: 2px solid #eee;
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
