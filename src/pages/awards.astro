<style>
  /* =========================================
     1. STANDARD 1100px LAYOUT (Fixes the "Width" Issue)
     ========================================= */
  .page-container {
    max-width: 1100px; /* 🎯 MATCHES YOUR OTHER PAGES EXACTLY */
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  /* =========================================
     2. HERO TYPOGRAPHY
     ========================================= */
  .intro-block {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 4rem;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #111;
    letter-spacing: -0.02em;
  }

  .intro-text {
    font-size: 1.25rem;
    line-height: 1.7;
    color: #444;
    max-width: 800px;
  }

  /* =========================================
     3. NEWS CARD LIST (Image Left / Text Right)
     ========================================= */
  .awards-list {
    display: flex;
    flex-direction: column;
    gap: 3rem; /* Spacing between items */
  }

  .news-card {
    display: flex;
    gap: 2.5rem; /* Space between Image and Text */
    align-items: flex-start;
    padding-bottom: 3rem;
    border-bottom: 1px solid #eee; /* Subtle divider line */
  }

  .news-card:last-child {
    border-bottom: none;
  }

  /* Image Box */
  .news-thumb {
    width: 280px;      /* Fixed width ensures perfect alignment */
    height: 180px;     /* Fixed height */
    flex-shrink: 0;    /* Prevents shrinking */
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #eee;
    background: #f9f9f9;
  }

  .news-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 📸 Crops photo nicely to fill the box */
    transition: transform 0.3s ease;
  }

  .news-card:hover .news-thumb img {
    transform: scale(1.05); /* Zoom effect on hover */
  }

  /* Content Box */
  .news-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 0.2rem;
  }

  .news-date {
    font-family: monospace;
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .news-content h3 {
    margin: 0 0 0.8rem 0;
    line-height: 1.3;
  }

.news-title-link {
    font-size: 1.3rem;
    font-weight: 700;
    color: #0067c0; /* 🎯 CHANGE THIS: Was #111, now matches Homepage Blue */
    text-decoration: none;
    transition: color 0.2s;
  }

  .news-title-link:hover {
    color: #004b99; /* Darker blue on hover */
    text-decoration: underline;
  }
  .news-title-link:hover {
    color: #0067c0; /* Academic Blue */
    text-decoration: underline;
  }

  .news-content p {
    font-size: 1rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .read-more-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0067c0;
    text-decoration: none;
  }

  .read-more-link:hover {
    text-decoration: underline;
    color: #004b99;
  }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .news-card {
      flex-direction: column; /* Stack image on top */
      gap: 1rem;
    }
    .news-thumb {
      width: 100%; /* Full width on phone */
      height: 220px;
    }
  }
</style>
