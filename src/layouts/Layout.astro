---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
	title?: string;
}

const { title = "Anson Chan" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>

		<meta
			name="description"
			content="Designing trustworthy human-AI decision systems."
		/>
	</head>

<body>

	<Navbar />

	<main>
		<slot />
	</main>

</body>

</html>